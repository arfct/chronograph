<?xml version="1.0" encoding="utf-8"?>
<!-- keyguard kept from the spike finding: registers on API 37, surfaces
     wherever the OS offers lock-screen/hub widgets (docs/parity.md). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:updatePeriodMillis="1800000"
    android:description="@string/timezones_widget_description" />
